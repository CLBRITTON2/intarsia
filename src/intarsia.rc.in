#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @INTARSIA_VERSION_MAJOR@, @INTARSIA_VERSION_MINOR@, @INTARSIA_VERSION_PATCH@, 0
PRODUCTVERSION @INTARSIA_VERSION_MAJOR@, @INTARSIA_VERSION_MINOR@, @INTARSIA_VERSION_PATCH@, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@INTARSIA_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@INTARSIA_VERSION@"
            VALUE "LegalCopyright", "Apache License 2.0"
            VALUE "OriginalFilename", "@INTARSIA_FILE_NAME@"
            VALUE "ProductName", "intarsia"
            VALUE "ProductVersion", "@INTARSIA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
